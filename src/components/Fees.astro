---
import SectionHead from './SectionHead.astro';
import { fees, cta } from '../content/site';
---

<section id="fees" class="band" data-tone="chalk" data-section-hour={fees.hour} aria-labelledby="fees-title">
  <div class="wrap">
    <SectionHead hour={fees.hour} label={fees.label} title={fees.title} id="fees-title" lead={fees.intro} />

    <ol class="rows">
      {fees.items.map((f, i) => (
        <li class="row">
          <div class="name">
            <p class="label"><span class="hour">0{i + 1}</span></p>
            <h3>{f.name}</h3>
            <p class="time num mute">{f.time}</p>
          </div>
          <div class="what">
            <p>{f.text}</p>
            <ul class="incl">
              {f.includes.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <p class="price">
            <span class="num amount">{f.price}</span>
            <span class="unit mute">{f.unit}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="foot">
      <p class="mute num">{fees.note}</p>
      <a class="link-arrow" href="#contact">{cta.short} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .rows {
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .row {
    display: grid;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .name {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .name h3 {
    font-size: var(--fs-h3);
    font-weight: 400;
    font-variation-settings: 'opsz' 36;
  }
  .time {
    font-size: var(--fs-small);
  }
  .what {
    display: grid;
    gap: var(--s-2);
    max-width: 36em;
  }
  .incl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
  .incl li {
    font-size: 0.85rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg-mute);
  }
  .price {
    display: grid;
    gap: 0.1rem;
  }
  .amount {
    font: 300 clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem) / 1 var(--serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .unit {
    font-size: var(--fs-small);
  }
  .foot {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    font-size: var(--fs-small);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr);
    }
    .price {
      justify-items: end;
      text-align: right;
    }
  }
</style>
