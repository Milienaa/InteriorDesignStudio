---
import { Picture } from 'astro:assets';
import { hero, cta } from '../content/site';
---

<section class="hero band" data-tone="chalk" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="grid hero-body">
      <h1 id="hero-title">
        {hero.headlineA}<br class="desk" />{' '}
        <em>{hero.headlineB}</em>
      </h1>

      <div class="copy">
        <p class="lead">{hero.lead}</p>
        <p class="now mute num" data-kyiv-time>{hero.staticNote}</p>
        <div class="actions">
          <a class="btn btn-ink" href="#contact">{cta.primary}</a>
          <a class="link-arrow" href="#work">{cta.secondary} <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <figure class="photo">
        <Picture
          src={hero.photo.src}
          alt={hero.photo.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 56vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="fade"
        />
        <figcaption class="cap">{hero.photo.caption}</figcaption>
      </figure>
    </div>

    <dl class="facts">
      {hero.facts.map((f) => (
        <div>
          <dt class="label">{f.label}</dt>
          <dd class="num">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  h1 {
    grid-column: 1 / -1;
    font-size: var(--fs-display);
    line-height: 0.98;
    max-width: 9.5em;
  }
  .desk {
    display: none;
  }
  .hero-body {
    row-gap: var(--s-4);
    align-items: start;
  }
  .copy {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .lead {
    max-width: 28em;
  }
  .now {
    font-size: var(--fs-small);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  .photo {
    grid-column: 1 / -1;
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--limestone);
  }
  .facts {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: var(--s-2) var(--s-2) var(--s-2) 0;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .facts dd {
    margin-top: 0.3em;
    font-size: var(--fs-small);
  }

  @media (min-width: 900px) {
    .hero-body {
      grid-template-rows: auto auto;
      row-gap: var(--s-4);
    }
    h1 {
      grid-column: 1 / 9;
      grid-row: 1;
    }
    .desk {
      display: inline;
    }
    .copy {
      grid-column: 1 / 7;
      grid-row: 2;
    }
    .photo {
      grid-column: 9 / -1;
      grid-row: 1 / 3;
      align-self: stretch;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .photo :global(picture) {
      min-height: 0;
      height: 100%;
    }
    .photo :global(img) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 500px;
      max-height: 640px;
    }
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .facts div {
      border-bottom: 0;
      padding-block: var(--s-3);
    }
    .facts div + div {
      padding-left: var(--s-3);
      border-left: 1px solid var(--line);
    }
  }
</style>
