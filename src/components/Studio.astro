---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { studio } from '../content/site';
---

<section id="studio" class="band" data-tone="limestone" data-section-hour={studio.hour} aria-labelledby="studio-title">
  <div class="wrap">
    <SectionHead hour={studio.hour} label={studio.label} title={studio.title} id="studio-title" />

    <div class="grid body">
      <figure class="photo">
        <Picture
          src={studio.photo.src}
          alt={studio.photo.alt}
          widths={[480, 560]}
          sizes="(min-width: 900px) 33vw, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
          class="fade"
        />
        <figcaption class="cap">{studio.photo.caption}</figcaption>
      </figure>

      <div class="text">
        <p class="lead">{studio.text}</p>
        <dl class="numbers">
          {studio.numbers.map((n) => (
            <div>
              <dt class="label">{n.label}</dt>
              <dd class="num">{n.value}</dd>
            </div>
          ))}
        </dl>
        <blockquote class="quote">
          <p>“{studio.quote.text}”</p>
          <footer class="label">{studio.quote.by}</footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<style>
  .body {
    row-gap: var(--s-4);
    align-items: start;
  }
  .photo {
    grid-column: 1 / -1;
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--noon);
  }
  .text {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-4);
  }
  .lead {
    max-width: 30em;
  }
  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3) var(--s-2);
    border-top: 1px solid var(--ink);
    padding-top: var(--s-3);
  }
  .numbers dd {
    font: 300 clamp(2rem, 1.5rem + 2vw, 3rem) / 1 var(--serif);
    font-variation-settings: 'opsz' 72;
    margin-top: 0.3rem;
  }
  .quote {
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-2);
  }
  .quote p {
    font: italic 300 clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem) / 1.3 var(--serif);
    font-variation-settings: 'opsz' 48;
    max-width: 24em;
  }

  @media (min-width: 900px) {
    .photo {
      grid-column: 1 / 5;
    }
    .text {
      grid-column: 6 / -1;
    }
    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
